# koreader2anki environment variables
# Copy this file to .env and fill in your values.
# Real exported env vars always take precedence.

# WebDAV URL to download the vocabulary builder database from
# DAV_URL=https://example.com/data/vocabulary_builder.sqlite3

# HTTP Basic auth: user:password
# DAV_AUTH=user:password

# AnkiConnect address (default: http://localhost:8765)
# ANKI_ADDRESS=http://localhost:8765
