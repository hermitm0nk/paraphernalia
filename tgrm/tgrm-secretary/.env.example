# Copy to .env and fill in. Never commit .env.
# 1. Create a bot via @BotFather (/newbot), enable Secretary Mode
#    (BotFather web app -> your bot -> Settings -> Bot Settings -> Mode Settings).
# 2. Attach it: your profile -> Edit -> Chat Automation -> select the bot,
#    allow Only selected chats, grant Manage Messages.
BOT_TOKEN=
# How to invoke pi (full path if not on PATH). Install needs your approval:
# npm install -g --ignore-scripts @earendil-works/pi-coding-agent
PI_BIN=/home/alex/.bun/bin/pi
# OpenRouter free tier (verified 2026-09-14). Free models rotate and
# rate-limit; swap PI_MODEL for another `:free` id if one 429s.
PI_PROVIDER=openrouter
PI_MODEL=thinkingmachines/inkling:free
PI_THINKING=low
PI_TIMEOUT=120
POLL_TIMEOUT=50
OWNER_NAME=Alex
# Optional: minutes after your last message in a chat during which the bot
# stays silent even for newer messages. 0 = off (only the replied-already
# rule applies).
OWNER_ACTIVE_MINUTES=0
# Grace window per visitor message: the bot waits this many seconds, then
# replies only if the last message in history is still the visitor's
# (i.e. you haven't answered yourself). 0 = reply immediately.
REPLY_DELAY_SECONDS=120
SYSTEM_PROMPT_FILE=SYSTEM.md
DATA_DIR=data
